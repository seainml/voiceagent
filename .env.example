# Copy to `.env` and fill in what you have. Everything here is optional —
# the agent boots and talks with no keys at all on macOS.
#
# Anything set here overrides voiceagent.toml but is overridden by a real
# environment variable.

# --- The reasoning model (pick one) ---------------------------------------
# DeepSeek (default endpoint in voiceagent.toml)
# DEEPSEEK_API_KEY=sk-...

# OpenAI
# OPENAI_API_KEY=sk-...
# VA_LLM__MODEL=gpt-4o-mini

# Moonshot / Zhipu / SiliconFlow / Groq / Together / anything OpenAI-compatible
# VA_LLM__BASE_URL=https://api.moonshot.cn/v1
# VA_LLM__API_KEY=sk-...
# VA_LLM__MODEL=moonshot-v1-8k

# Local server (Ollama, vLLM, LM Studio) — no key needed
# VA_LLM__BASE_URL=http://127.0.0.1:11434/v1
# VA_LLM__MODEL=qwen2.5:7b

# --- Cloud speech (optional; macOS `say` is the zero-config default) -------
# VA_TTS__PROVIDER=openai
# VA_TTS__VOICE=alloy
# VA_TTS__RESPONSE_FORMAT=pcm

# VA_ASR__PROVIDER=openai
# VA_ASR__MODEL=whisper-1

# --- Free neural TTS (uv pip install -e '.[edge]') -------------------------
# VA_TTS__PROVIDER=edge
# VA_TTS__VOICE=zh-CN-XiaoxiaoNeural

# --- Bias recognition toward your own vocabulary ---------------------------
# VA_ASR__HOTWORDS=["voiceagent","Kubernetes","Zhang Wei"]

# --- Config file location --------------------------------------------------
# VA_CONFIG=voiceagent.local.toml
